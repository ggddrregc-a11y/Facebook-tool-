# ============================================================
# Grok AI Social Manager - Environment Variables
# ============================================================

# ── Application ────────────────────────────────────────────
APP_SECRET=your_app_secret_here_min_32_chars
VERIFY_TOKEN=your_webhook_verify_token_here
SECRET_KEY=your_secret_key_here_min_32_chars

# ── Facebook ───────────────────────────────────────────────
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_page_id_here   # Find at: facebook.com/<page> → About → Page ID

# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/grok_social_db

# ── Grok / xAI API Keys ────────────────────────────────────
# تعدد المفاتيح: عند انتهاء ليمت مفتاح يتحول تلقائياً للتالي
GROK_API_KEY=xai-your-primary-key-here
GROK_API_KEY_2=xai-your-second-key-here
GROK_API_KEY_3=xai-your-third-key-here
GROK_API_KEY_4=
GROK_API_KEY_5=
GROK_API_KEY_6=
GROK_API_KEY_7=
GROK_API_KEY_8=
GROK_API_KEY_9=
GROK_API_KEY_10=

GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ── Post Scheduling ────────────────────────────────────────
POST_SCHEDULER_INTERVAL_SECONDS=60     # كل كم ثانية يفحص السكيدولر
POST_AUTO_APPROVE=false                # true = ينشر مباشر بدون مراجعة

# ── Image Generation (اختياري) ────────────────────────────
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1
IMAGE_GENERATION_MODEL=dall-e-3

# ── JWT Authentication ─────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── Admin Credentials ──────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Cache (اختياري) ────────────────────────────────────────
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── App Settings ───────────────────────────────────────────
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
