# ============================================================
# Facebook AI Auto Reply System - Environment Variables
# ============================================================

# Application
APP_SECRET=your_app_secret_here_min_32_chars
VERIFY_TOKEN=your_webhook_verify_token_here
SECRET_KEY=your_secret_key_here_min_32_chars

# Facebook
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/facebook_ai_db

# OpenAI Compatible API (Default: OpenRouter with Qwen3)
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen3-8b:free

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Logging
LOG_LEVEL=INFO

# Cache (Redis - Optional)
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# App Settings
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
